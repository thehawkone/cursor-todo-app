{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/detect-push-request.js",
        "matcher": "UserPromptSubmit"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/push-to-github.js",
        "matcher": "Stop"
      }
    ]
  }
}
